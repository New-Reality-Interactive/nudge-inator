<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	Collected data types stay empty on purpose. Sharing puts these in the person's own iCloud
	(CloudKit records, end-to-end encrypted), only to send and receive reminders (App Functionality):
	Name (NSPrivacyCollectedDataTypeName), the person's name as iCloud gives it; Other User Content
	(NSPrivacyCollectedDataTypeOtherUserContent), a sender's reminder content and a recipient's
	receipt and status. Apple counts data as "collected" only when it is sent off the device so that
	the developer can reach it; New Reality Interactive can't read the person's iCloud, so none of it
	is. Source and the App Store label answer: docs/agents/privacy-compliance.md.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
