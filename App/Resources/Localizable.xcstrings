    "Delete" : {
      "comment" : "Reminders tab, Sent: a row's swipe action and VoiceOver action that asks before deleting the sent reminder from everyone's iPhone.\nReminders tab: a row's swipe action and VoiceOver action that asks before deleting the reminder.\nSettings: confirms deleting every reminder, tag and all history.\nTags: a row's swipe action and VoiceOver action that asks before deleting the tag."
    },
    "Delete %@?" : {
      "comment" : "Tags: title of the question that asks before deleting a tag. The placeholder is the tag, such as \"#home\"."
