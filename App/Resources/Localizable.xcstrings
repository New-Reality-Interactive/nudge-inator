    "Choose an address" : {
      "comment" : "Invite Someone: title of the choice between a contact's email addresses and phone numbers."
    },
    "Choose at least one day to save." : {
      "comment" : "Add Schedule and Edit Schedule (quiet hours): under the days, in red, while no day is checked, so Save is off."
    },
    "Choose from Contacts" : {
      "comment" : "Invite Someone: the plus beside the address field, which opens the contact picker."
    },
    "Choose from six tones, from the gentle Chime to the insistent Siren. Default Alarm is iOS's own sound, which apps can't play, so you'll hear it when an alarm rings." : {
      "comment" : "How Alarm Sounds Work, Pick Your Default Sound: under \"Tap a tone to hear it\". Chime, Siren and Default Alarm are alarm sound names."
    },
    "Choose one or more days." : {
      "comment" : "Under the Custom repeat page's weekdays."
    },
    "Choose one or more people. Each gets their own copy, at this strength, and it won't nudge you." : {
      "comment" : "Under the Send To page's list of people."
    },
    "Choose the sound alarms ring with in Settings, under Default Alarm Sound, and for each reminder, under Sound on its form." : {
      "comment" : "How It Nudges only, not onboarding: under the point \"Urgent nudges ring as alarms\". Default Alarm Sound is the Settings row, and Sound is the reminder form's row."
    },
    "Choosing a sound above leaves the reminders you already have as they are. This gives every one of them %@, including reminders someone sent you." : {
      "comment" : "Default Alarm Sound page: under Use for All Reminders. The placeholder is the sound chosen above, such as \"Chime\"."
    },
    "Choosing a sound plays it. Default Alarm is iOS's own sound, which apps can't play, so you'll hear it when an alarm rings." : {
      "comment" : "Under the alarm sound list, after the line on when it plays. Default Alarm is the first sound in the list, iOS's own alarm sound."
    },
    "Clear All Filters" : {
      "comment" : "My Day: the item in the Filter button's menu that removes every tag, No Tags and From others from the filter.\nReminders and Tags: the item in the Filter button's menu that removes every sheet filter, and leaves the search."
