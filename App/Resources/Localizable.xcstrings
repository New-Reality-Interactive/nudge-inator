                      "value" : "%arg filters"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld more tags" : {
      "comment" : "VoiceOver label of My Day's \"+N more\" filter token. The placeholder is how many more tags are chosen.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld more tag"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld more tags"
                }
              }
            }
          }
        }
      }
    },
    "%lld nudges over %@, then it gives up." : {
      "comment" : "How It Nudges footer. 1: how many nudges a reminder sends before it gives up. 2: how long that takes from the due time, such as \"2 hr, 18 min\".",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld nudge over %2$@, then it gives up."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld nudges over %2$@, then it gives up."
                }
              }
            }
          }
        }
      }
    },
    "%lld reminders from %@" : {
      "comment" : "The Apple Account Changed sheet: the received reminders removed. 1: how many. 2: who sent them, as a list, such as \"Maya Torres and Sam Okafor\".",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld reminder from %2$@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld reminders from %2$@"
                }
              }
            }
          }
        }
      }
    },
    "%lld reminders out of %lld" : {
      "comment" : "Reminders tab, Mine and Sent: the header row's count, in every case, even with nothing narrowing the list. 1: the reminders shown. 2: every reminder (on Sent, every reminder sent, one sent to two people counting once).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@reminders@ out of %2$lld"
          },
          "substitutions" : {
            "reminders" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg reminder"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg reminders"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld reminders use this tag. It's removed from them, and they aren't deleted." : {
      "comment" : "Tags: the message of the question that asks before deleting a tag. The placeholder is how many reminders have the tag.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld reminder uses this tag. It's removed from it, and it isn't deleted."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld reminders use this tag. It's removed from them, and they aren't deleted."
                }
              }
            }
          }
        }
      }
    },
    "%lld reminders with %@" : {
      "comment" : "A tag's screen: under the title. 1: how many reminders have the tag. 2: the tag, such as \"#home\".",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld reminder with %2$@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld reminders with %2$@"
                }
              }
            }
          }
        }
      }
    },
    "%lld reminders you sent" : {
