{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "My Day: under the title of an occurrence due later today. The placeholder is how soon, such as \"in 4 hr.\"."
    },
    "%@ %@" : {
      "comment" : "Via label: a glyph, then how a nudge arrives. Keep the glyph first.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ accepted. It nudges you as your own reminders do." : {
      "comment" : "VoiceOver: spoken after Accept on a Waiting for You row on Now, as the row leaves the section. The placeholder is the reminder's title."
    },
    "%@ at %@" : {
      "comment" : "A day and a time of day, such as \"Today at 8:02 AM\". 1: the day, such as \"Today\" or \"Tue, Oct 20\". 2: the time.\nAn invited person's page: when the invite was sent. 1: \"Today\", \"Yesterday\" or a short date. 2: the time, such as \"7:40 AM\".\nReminder details, Schedule: the next due time. 1: \"Today\", \"Tomorrow\" or a short date. 2: the time, such as \"8:00 AM\".\nShare Activity: when an entry happened. 1: \"Today\", \"Yesterday\" or a short date. 2: the time, such as \"7:58 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@"
          }
        }
      }
    },
    "%@ canceled this reminder, so it won't nudge you. It stays here until you remove it." : {
      "comment" : "Reminder details: under \"Canceled\" on a received reminder its sender deleted. The placeholder is the sender's name."
    },
    "%@ changed this · %@" : {
      "comment" : "Reminder details: heading of the note on a received reminder its sender changed. 1: the sender's name. 2: when the change arrived, such as \"Today at 8:02 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ changed this · %2$@"
          }
        }
      }
    },
    "%@ changed this: %@" : {
      "comment" : "Body of the notification that the sender changed a reminder they sent. 1: the sender's name. 2: what changed, such as \"due time changed from 8:30 AM to 9:00 AM\", or several joined as a list.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ changed this: %2$@"
          }
        }
      }
    },
    "%@ ended your connection. You can't send each other reminders until one of you invites the other again." : {
      "comment" : "The Connection Ended sheet: its first line. The argument is the other person's name, such as \"Alex Morgan\"."
    },
    "%@ gets a note that the connection ended, and chooses what happens to the reminders you sent." : {
      "comment" : "Disconnect's sheet: under the choice. The argument is the other person's name, such as \"Alex Morgan\"."
    },
    "%@ has more than one address. Use the one that is their Apple Account." : {
      "comment" : "Invite Someone: under the choice between a contact's addresses. The argument is the contact's name."
    },
    "%@ invited you to send each other reminders through iCloud. Sharing is off on this iPhone." : {
      "comment" : "Opening an invite while Sharing is off: under the title. The argument is the name of the person who sent the invite, such as \"Alex Morgan\"."
    },
    "%@ is Done. Its nudges have stopped." : {
      "comment" : "VoiceOver: spoken after Done on a Reminders row's action, and what a nudge card's or My Day row's Done button place says after Done. The placeholder is the reminder's title."
    },
    "%@ marked it Done" : {
      "comment" : "Body of the notification to the sender that the person they sent a reminder to marked it Done. 1: the person's name."
    },
    "%@ owns this schedule." : {
      "comment" : "Reminder details: under Schedule of a received reminder, which only its sender can change. The placeholder is the sender's name."
    },
    "%@ owns this schedule. The sound is yours: it's chosen on this iPhone." : {
      "comment" : "Reminder details: under Schedule of a received reminder that rings as an alarm. Only its sender can change the schedule, but its alarm sound is the person's own. The placeholder is the sender's name."
    },
    "%@ paused. It won't nudge you until you resume it." : {
      "comment" : "VoiceOver: spoken after Pause Reminder on a reminder's details. The placeholder is the reminder's title."
    },
    "%@ removed it" : {
      "comment" : "Body of the notification to the sender that the person they sent a reminder to removed it. 1: the person's name."
    },
    "%@ removed." : {
      "comment" : "VoiceOver: spoken after Remove on a Waiting for You row on Now is confirmed, as the row goes. The placeholder is the reminder's title."
    },
    "%@ resumed. It nudges you when it's next due." : {
      "comment" : "VoiceOver: spoken after Resume Reminder on a reminder's details. The placeholder is the reminder's title."
    },
    "%@ sees how the reminders they send you are going: Done, Paused, Missed or Removed, and the last 7 days of a repeating one. They also see when you last opened the app." : {
      "comment" : "A connection's page: under Status Sharing when it's on. The argument is the other person's name, such as \"Alex Morgan\"."
    },
    "%@ sees how this one is going." : {
      "comment" : "Reminder details: under Don't share this one while it's off. The placeholder is the sender's name."
    },
    "%@ sees only that a reminder was Delivered." : {
      "comment" : "A connection's page: under Status Sharing when it's off. The argument is the other person's name, such as \"Alex Morgan\"."
    },
    "%@ sees “Not sharing this one” in place of how it's going." : {
      "comment" : "Reminder details: under Don't share this one while it's on. The placeholder is the sender's name."
    },
    "%@ to %@, Every %@" : {
      "comment" : "Quiet Hours page: what VoiceOver reads for a schedule: its start and end times, then the days it starts on, such as \"10:00 PM to 7:00 AM, Every Fri and Sat\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@, Every %3$@"
          }
        }
      }
    },
    "%@ to %@, Every day" : {
      "comment" : "Quiet Hours page: what VoiceOver reads for a schedule that runs every day: its start and end times, such as \"10:00 PM to 7:00 AM, Every day\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ to %2$@, Every day"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "A tag's screen: under a reminder's title. 1: its tags, such as \"#home #errands\", this screen's tag in bold. 2: its schedule, such as \"Every day at 8:00 AM\".\nBody of the notification that a reminder someone sent has arrived. 1: who sent it, such as \"From Alex Morgan\". 2: its strength in words, such as \"Firm: rings as an alarm from nudge 4\".\nMy Day: under the title of a tagged reminder. 1: its tags, such as \"#home #errands\", the ones the filter chose in bold. 2: the note, such as \"Nudging · 2 nudges · next 1:15 PM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@. Nudges in it will arrive again." : {
      "comment" : "Edit Schedule (quiet hours): the message of the question that asks before deleting the schedule. 1: its times, such as \"10:00 PM–7:00 AM\". 2: its days, such as \"Every day\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@. Nudges in it will arrive again."
          }
        }
      }
    },
    "%@ · **%lld reminders nudging you**" : {
      "comment" : "Now: under the title; the bold part shows in red. 1: today's short date, such as \"Sat, Oct 17\". 2: how many reminders are nudging.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · **%2$lld reminder nudging you**"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · **%2$lld reminders nudging you**"
                }
              }
            }
          }
        }
      }
    },
    "%@ · Nothing is nudging you" : {
      "comment" : "Now: under the title when nothing is nudging. The placeholder is today's short date, such as \"Sat, Oct 17\"."
    },
    "%@ · due %@" : {
      "comment" : "Nudge card: under the title. 1: the reminder's tags, such as \"#home #errands\". 2: its due time, such as \"9:00 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · due %2$@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Reminder details, Schedule: when the latest occurrence closed. 1: \"Today\", \"Yesterday\" or a short date. 2: the time, such as \"9:40 AM\".\nVoiceOver label of a received reminder's nudge card. 1: the reminder's title. 2: who sent it, such as \"From Riley Park\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@, %@, %@" : {
      "comment" : "VoiceOver label of a Reminders tab row with no tags. 1: the reminder's title. 2: its status, such as \"Nudging\". 3: its due day, such as \"Today\". 4: its due time, such as \"9:00 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$@, %4$@"
          }
        }
      }
    },
    "%@, %@, %@, %@, %@" : {
      "comment" : "VoiceOver label of a row on the Reminders tab's Sent view. 1: who it was sent to, such as \"Riley Park\". 2: the reminder's title. 3: how the copy is going, such as \"Done\", \"Delivered, Not sharing status\", \"Not delivered yet\" or \"Waiting for them to accept\". 4: its due day, such as \"Today\". 5: its due time, such as \"9:00 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$@, %4$@, %5$@"
          }
        }
      }
    },
    "%@, %@, %@, %@, %@, %@" : {
      "comment" : "VoiceOver label of a Reminders tab row of a received reminder with no tags. 1: the reminder's title. 2: who sent it, such as \"From Riley Park\". 3: its strength, such as \"Firm\". 4: its status, such as \"Nudging\". 5: its due day, such as \"Today\". 6: its due time, such as \"9:00 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$@, %4$@, %5$@, %6$@"
          }
        }
      }
    },
    "%@, %@, %@, %@, %@, %@, tags: %@" : {
      "comment" : "VoiceOver label of a Reminders tab row of a received reminder. 1: the reminder's title. 2: who sent it, such as \"From Riley Park\". 3: its strength, such as \"Firm\". 4: its status, such as \"Nudging\". 5: its due day, such as \"Today\". 6: its due time, such as \"9:00 AM\". 7: its tags, such as \"#home and #errands\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$@, %4$@, %5$@, %6$@, tags: %7$@"
          }
        }
      }
    },
    "%@, %@, %@, %@, tags: %@" : {
      "comment" : "VoiceOver label of a Reminders tab row. 1: the reminder's title. 2: its status, such as \"Nudging\". 3: its due day, such as \"Today\". 4: its due time, such as \"9:00 AM\". 5: its tags, such as \"#home and #errands\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, %3$@, %4$@, tags: %5$@"
          }
        }
      }
    },
    "%@, Last 7 Days" : {
      "comment" : "A sent reminder's details: section header over one person's last 7 days of the reminder. The placeholder is the person's short name, such as \"Riley\"."
    },
    "%@, Waiting to sync" : {
      "comment" : "VoiceOver, on a received reminder's row or card: who sent it, then that what this person's app tells them hasn't gone through iCloud yet. The placeholder is such as \"From Riley Park\"."
    },
    "%@, including invites not yet accepted." : {
      "comment" : "The Apple Account Changed sheet: under the connections removed. The placeholder is their names, as a list, such as \"Maya Torres, Sam Okafor, and Jordan Lee\"."
    },
    "%@, nudge %lld of %lld, urgency %@. %@. %@" : {
      "comment" : "VoiceOver value of a nudge card after its last nudge. 1: the strength, such as \"Gentle\". 2: the nudges sent. 3: the most it sends. 4: the urgency now, such as \"High\". 5: the tags and due time, such as \"#home · due 9:00 AM\". 6: the card's line saying that was the last nudge and when it closes as Missed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, nudge %2$lld of %3$lld, urgency %4$@. %5$@. %6$@"
          }
        }
      }
    },
    "%@, nudge %lld of %lld, urgency %@. %@. Next nudge %@: %@, %@." : {
      "comment" : "VoiceOver value of a nudge card. 1: the strength, such as \"Gentle\". 2: the nudges sent. 3: the most it sends. 4: the urgency now, such as \"High\". 5: the tags and due time, such as \"#home · due 9:00 AM\". 6: the next nudge's time. 7: how it arrives, such as \"Alarm\". 8: its urgency.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, nudge %2$lld of %3$lld, urgency %4$@. %5$@. Next nudge %6$@: %7$@, %8$@."
          }
        }
      }
    },
    "%@." : {
      "comment" : "A repeat summary as a sentence, under the reminder form's Starts. The placeholder is the engine's summary, such as \"Every 3 days at 9:00 AM\".\nTop of the Custom repeat page: the repeat as a sentence. The placeholder is the engine's summary, such as \"Every 2 weeks on Monday at 9:00 AM\"."
    },
    "%@. %@" : {
      "comment" : "VoiceOver label of a dimmed confirm button in a sheet's top bar (Add, Save, Done). 1: the button's name, such as \"Add\". 2: why it is dimmed, such as \"Add a title to save.\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@. %2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "VoiceOver, a repeating sent reminder's last 7 days on the Sent view: one day and how the person's copy went. 1: the weekday, such as \"Thursday\", or \"Today\". 2: the status, such as \"Done\" or \"Missed\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: Nothing due" : {
      "comment" : "VoiceOver, a repeating sent reminder's last 7 days on the Sent view: a day the person's copy had nothing due. The placeholder is the weekday, such as \"Thursday\", or \"Today\"."
    },
    "%@: every nudge rings as an alarm" : {
      "comment" : "A received reminder's strength in words, on its arrival notification and its details, when every nudge rings. The placeholder is the strength, such as \"Firm\"."
    },
    "%@: never rings as an alarm" : {
      "comment" : "A received reminder's strength in words, on its arrival notification and its details, when none of its nudges rings. The placeholder is the strength, such as \"Gentle\"."
    },
    "%@: rings as an alarm from nudge %lld" : {
      "comment" : "A received reminder's strength in words, on its arrival notification and its details. 1: the strength, such as \"Firm\". 2: the first nudge that rings as an alarm.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: rings as an alarm from nudge %2$lld"
          }
        }
      }
    },
    "%@–%@" : {
      "comment" : "Quiet Hours page: a schedule's times, start then end, joined by an en dash with no spaces, such as \"10:00 PM–7:00 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@–%2$@"
          }
        }
      }
    },
    "%lld Reminders You've Received" : {
      "comment" : "Turn Off Sharing's sheet: header of the Remove or Keep choice. The argument is how many reminders this person has received from everyone.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Reminder You've Received"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Reminders You've Received"
                }
              }
            }
          }
        }
      }
    },
    "%lld Reminders from %@" : {
      "comment" : "Disconnect's sheet: header of the choice. 1: how many reminders received from the person Keep would keep. 2: their name, such as \"Alex Morgan\".",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Reminder from %2$@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$lld Reminders from %2$@"
                }
              }
            }
          }
        }
      }
    },
    "%lld chosen" : {
      "comment" : "VoiceOver value of My Day's filter button while tags or From others are chosen. The placeholder is how many: the tags, and one for From others.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld chosen"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld chosen"
                }
              }
            }
          }
        }
      }
    },
    "%lld connections" : {
      "comment" : "The Apple Account Changed sheet: the connections removed, invites among them. The placeholder is how many.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld connection"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld connections"
                }
              }
            }
          }
        }
      }
    },
    "%lld filters on" : {
      "comment" : "VoiceOver value of the Filter button on Reminders and Tags while the sheet's filters are on. The placeholder is how many of its sections are in use.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@n@ on"
          },
          "substitutions" : {
            "n" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
