              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · **%2$lld reminders nudging you**"
                }
              }
            }
          }
        }
      }
    },
    "%@ · Nothing is nudging you" : {
      "comment" : "Now: under the title when nothing is nudging. The placeholder is today's short date, such as \"Sat, Oct 17\"."
    },
    "%@ · due %@" : {
      "comment" : "Nudge card: under the title. 1: the reminder's tags, such as \"#home #errands\". 2: its due time, such as \"9:00 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · due %2$@"
