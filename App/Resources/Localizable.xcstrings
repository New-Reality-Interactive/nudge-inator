{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "comment" : "My Day: under the title of an occurrence due later today. The placeholder is how soon, such as \"in 4 hr.\"."
    },
    "%@ %@" : {
      "comment" : "Via label: a glyph, then how a nudge arrives. Keep the glyph first.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ at %@" : {
      "comment" : "Reminder details, Schedule: the next due time. 1: \"Today\", \"Tomorrow\" or a short date. 2: the time, such as \"8:00 AM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "My Day: under the title of a tagged reminder. 1: its tags, such as \"#home #errands\", the ones the filter chose in bold. 2: the note, such as \"Nudging · 2 nudges · next 1:15 PM\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · **%lld reminders nudging you**" : {
      "comment" : "Now: under the title; the bold part shows in red. 1: today's short date, such as \"Sat, Oct 17\". 2: how many reminders are nudging.",
