  "sourceLanguage" : "en",
  "strings" : {
    "%@ · Nothing is nudging you" : {
      "comment" : "Now: under the title. The placeholder is today's short date, such as \"Sat 17 Oct\"."
    },
    "%@." : {
      "comment" : "A repeat summary as a sentence, under the reminder form's Starts and under the Repeat page's Custom row. The placeholder is the engine's summary, such as \"Every 3 days at 9:00 AM\".\nTop of the Custom repeat page: the repeat as a sentence. The placeholder is the engine's summary, such as \"Every 2 weeks on Monday at 9:00 AM\"."
    },
    "**All clear.** Nothing needs you right now." : {
      "comment" : "Now: the Nudging section when nothing is nudging."
    },
    "**Nudging now.** Start, repeat, strength and Break Through Focus are locked while it's nudging. Mark it Done or pause it to change them. A new title shows from the next nudge." : {
      "comment" : "Top of the Edit Reminder form while the reminder is nudging: why four fields are locked."
    },
    "A new schedule applies from the next time it's due. A new strength or Break Through Focus setting applies from the next nudge." : {
      "comment" : "Top of the Edit Reminder form when the reminder isn't nudging: when changes apply."
    },
    "Add" : {
      "comment" : "The New Reminder form's confirm button (a checkmark).\nThe Tags page's button that adds the typed tag to the reminder."
