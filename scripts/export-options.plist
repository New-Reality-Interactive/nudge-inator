<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The TestFlight upload (#99). scripts/archive-and-upload.sh copies this file for validation,
	     changing only `method`. No key, password or other secret: the upload
	     uses the Apple ID signed into Xcode. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>B9QHGF334U</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
	<!-- An internal-only build can never go to the App Store, so this stays off. -->
	<key>testFlightInternalTestingOnly</key>
	<false/>
</dict>
</plist>
